<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.apps.mapper.read.ReadingMapper">

    <resultMap id="ReadingResultMap" type="com.apps.model.read.Reading">
        <id property="id" column="COL_ID"/>
        <result property="title" column="COL_TITLE"/>
        <result property="content" column="COL_CONTENT"/>
        <result property="imageBase64" column="COL_IMAGE_BASE64"/>
        <result property="createdAt" column="COL_CREATED_AT"/>
        <result property="updatedAt" column="COL_UPDATED_AT"/>
        <result property="readSummaryId" column="COL_READING_SUMMARY_ID"/>
    </resultMap>

    <!-- 插入阅读材料 -->
    <insert id="insertReading" parameterType="com.apps.model.read.Reading" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO COL_READING (COL_TITLE, COL_CONTENT, COL_IMAGE_BASE64, COL_READING_SUMMARY_ID, COL_ID)
        VALUES (#{title}, #{content}, #{imageBase64}, #{readSummaryId},#{id})
    </insert>

    <!-- 根据 ID 查询阅读材料 -->
    <select id="selectReadingById" resultMap="ReadingResultMap">
        SELECT * FROM COL_READING WHERE COL_ID = #{id}
    </select>

    <!-- 查询所有阅读材料 -->
    <select id="selectAllReadings" resultMap="ReadingResultMap">
        SELECT * FROM COL_READING
    </select>

    <select id="selectAllReadingSummary" resultMap="ReadingSummaryResultMap">
        SELECT * FROM COL_READING_SUMMARY
    </select>
    <!-- 更新阅读材料 -->
    <update id="updateReading" parameterType="com.apps.model.read.Reading">
        UPDATE COL_READING
        SET COL_TITLE = #{title},
            COL_CONTENT = #{content},
            COL_IMAGE_BASE64 = #{imageBase64}
        WHERE COL_ID = #{id}
    </update>

    <!-- 根据 ID 删除阅读材料 -->
    <delete id="deleteReadingById">
        DELETE FROM COL_READING WHERE COL_ID = #{id}
    </delete>


    <!-- 插入阅读汇总 -->
    <insert id="insertReadingSummary" parameterType="com.apps.model.read.ReadingSummary" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO COL_READING_SUMMARY (COL_TITLE, COL_CREATED_AT, COL_UPDATED_AT, COL_ID)
        VALUES (#{title}, #{createdAt}, #{updatedAt},#{id})
    </insert>

    <resultMap id="ReadingSummaryResultMap" type="com.apps.model.read.ReadingSummary">
        <id property="id" column="COL_ID"/>
        <result property="title" column="COL_TITLE"/>
        <result property="createdAt" column="COL_CREATED_AT"/>
        <result property="updatedAt" column="COL_UPDATED_AT"/>
    </resultMap>

    <!-- 根据 ID 查询阅读汇总 -->
    <select id="selectReadingSummaryById" resultMap="ReadingSummaryResultMap">
        SELECT COL_ID, COL_TITLE, COL_CREATED_AT, COL_UPDATED_AT
        FROM COL_READING_SUMMARY
        WHERE COL_ID = #{id}
    </select>

    <!-- 删除阅读汇总 -->
    <delete id="deleteReadingSummaryById">
        DELETE FROM COL_READING_SUMMARY WHERE COL_ID = #{id}
    </delete>

    <!-- 根据阅读汇总 ID 查询关联的阅读材料 -->
    <select id="selectReadingsBySummaryId" resultMap="ReadingResultMap">
        SELECT * FROM COL_READING WHERE COL_READING_SUMMARY_ID = #{summaryId}
    </select>

</mapper>