<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.apps.mapper.ReadingMapper">

    <resultMap id="ReadingResultMap" type="com.apps.model.Reading">
        <id property="id" column="COL_ID"/>
        <result property="title" column="COL_TITLE"/>
        <result property="content" column="COL_CONTENT"/>
        <result property="imageBase64" column="COL_IMAGE_BASE64"/>
        <result property="createdAt" column="COL_CREATED_AT"/>
        <result property="updatedAt" column="COL_UPDATED_AT"/>
    </resultMap>

    <!-- 插入阅读材料 -->
    <insert id="insertReading" parameterType="com.apps.model.Reading" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO COL_READING (COL_TITLE, COL_CONTENT, COL_IMAGE_BASE64)
        VALUES (#{title}, #{content}, #{imageBase64})
    </insert>

    <!-- 根据 ID 查询阅读材料 -->
    <select id="selectReadingById" resultMap="ReadingResultMap">
        SELECT * FROM COL_READING WHERE COL_ID = #{id}
    </select>

    <!-- 查询所有阅读材料 -->
    <select id="selectAllReadings" resultMap="ReadingResultMap">
        SELECT * FROM COL_READING
    </select>

    <!-- 更新阅读材料 -->
    <update id="updateReading" parameterType="com.apps.model.Reading">
        UPDATE COL_READING
        SET COL_TITLE = #{title},
            COL_CONTENT = #{content},
            COL_IMAGE_BASE64 = #{imageBase64}
        WHERE COL_ID = #{id}
    </update>

    <!-- 根据 ID 删除阅读材料 -->
    <delete id="deleteReadingById">
        DELETE FROM COL_READING WHERE COL_ID = #{id}
    </delete>

</mapper>