<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.apps.mapper.UserMapper">

    <!-- 字段映射 -->
    <resultMap id="UserResultMap" type="com.apps.model.User">
        <id property="id" column="user_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="role" column="role"/>
    </resultMap>

    <!-- 插入用户 -->
    <insert id="insertUser" parameterType="com.apps.model.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO COL_Users (username, password, email, role)
        VALUES (#{username}, #{password}, #{email}, #{role})
    </insert>

    <!-- 更新用户 -->
    <update id="updateUser">
        UPDATE COL_Users
        SET username = #{username},
            password = #{password},
            email = #{email},
            role = #{role}
        WHERE user_id = #{id}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteUserById">
        DELETE FROM COL_Users WHERE user_id = #{id}
    </delete>

    <!-- 根据 ID 查询用户 -->
    <select id="selectUserById" resultMap="UserResultMap">
        SELECT * FROM COL_Users WHERE user_id = #{id}
    </select>

    <!-- 根据用户名查询用户 -->
    <select id="selectUserByUsername" resultMap="UserResultMap">
        SELECT * FROM COL_Users WHERE username = #{username}
    </select>

</mapper>